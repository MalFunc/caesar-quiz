# ================= PRODUKSI =================
# Copy jadi .env di root project:  cp .env.example .env
# Lalu jalankan:                   docker compose up -d --build

# ---- Backend / database ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=caesar_quiz
PORT=8080

# Origin browser yang boleh akses API (WAJIB = domain frontend)
CORS_ORIGINS=https://quiz.cyronethic.tech

# ---- Frontend (dibaca runtime oleh /runtime-config.js) ----
API_BASE=https://api.cyronethic.tech
# Untuk produksi HTTPS WAJIB wss://
WS_BASE=wss://api.cyronethic.tech


# ================= DEV LOKAL (contoh) =================
# CORS_ORIGINS=http://localhost:3000
# API_BASE=http://localhost:8080
# WS_BASE=ws://localhost:8080
