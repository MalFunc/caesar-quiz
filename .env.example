# ===== Backend / database =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=caesar_quiz
PORT=8080

# Origin browser yang diizinkan mengakses API (dipisah koma).
# Contoh: https://quiz.cyronethic.tech
# Gunakan * hanya untuk dev (mengizinkan semua origin).
CORS_ORIGINS=http://localhost:3000

# ===== Frontend (dibaca runtime oleh /runtime-config.js) =====
# URL publik backend. Bisa diganti + restart container tanpa rebuild.
API_BASE=http://localhost:8080
# Untuk produksi HTTPS, WAJIB pakai wss://
WS_BASE=ws://localhost:8080
