# Contoh konfigurasi nginx untuk Caesar Quiz.
# Asumsi: frontend di localhost:3000, backend (API + WS) di localhost:8080.
# Cloudflare (orange cloud) menangani TLS, jadi origin cukup listen :80.
# Salin ke /etc/nginx/sites-available/caesar-quiz lalu:
#   ln -s /etc/nginx/sites-available/caesar-quiz /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx

# ---- Frontend: quiz.cyronethic.tech ----
server {
    listen 80;
    server_name quiz.cyronethic.tech;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# ---- Backend API + WebSocket: api.cyronethic.tech ----
server {
    listen 80;
    server_name api.cyronethic.tech;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Wajib untuk WebSocket
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
