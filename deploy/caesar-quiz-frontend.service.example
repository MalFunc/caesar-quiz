# Contoh systemd unit untuk frontend Next.js (jalur TANPA Docker).
# Prasyarat di /root/caesar-quiz/frontend/frontend:
#   npm ci && npm run build
# Simpan ke /etc/systemd/system/caesar-quiz-frontend.service
# lalu: systemctl daemon-reload && systemctl enable --now caesar-quiz-frontend

[Unit]
Description=Caesar Quiz Frontend (Next.js)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/caesar-quiz/frontend/frontend
Environment="NODE_ENV=production"
Environment="PORT=3000"
Environment="HOSTNAME=127.0.0.1"
Environment="API_BASE=https://api.cyronethic.tech"
Environment="WS_BASE=wss://api.cyronethic.tech"
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
